{
  "schema_version": "1.0",
  "policy": {
    "default": "DENY",
    "cross_cell_mutations_via_middleware_only": true,
    "direct_database_links_across_cells": false,
    "shared_provider_credentials": false,
    "shared_n8n_credentials": false,
    "live_effects_enabled": false
  },
  "cells": [
    {"id":"edge-identity","purpose":"Public TLS, API traffic policy, identity issuance, and token validation compatibility.","systems":["caddy","kong","keycloak"],"allowed_flows":["client -> caddy -> kong -> middleware","middleware/kong -> keycloak jwks and issuer validation"],"forbidden_flows":["caddy -> provider runtime","kong -> provider credentials","keycloak -> business record mutation"]},
    {"id":"middleware-core","purpose":"Canonical command, event, inbox, outbox, operation, audit, capability, and reconciliation authority.","systems":["middleware"],"allowed_flows":["validated caller -> middleware command/read API","middleware -> approved adapter target","provider event -> middleware signed inbox","middleware -> nats/temporal internal durability"],"forbidden_flows":["unvalidated tenant header authority","success without provider readback","retry after unknown outcome without reconciliation"]},
    {"id":"core-control-plane","purpose":"Controlled provisioning and lifecycle services invoked by Middleware.","systems":["provisioning"],"allowed_flows":["middleware -> provisioning service","provisioning events -> middleware"],"forbidden_flows":["n8n -> provider direct","unreviewed resource creation","identity authority duplication"]},
    {"id":"automation","purpose":"Non-authoritative workflow timing, branching, approvals, and SLA coordination.","systems":["n8n"],"allowed_flows":["n8n -> private middleware automation API","middleware operation state -> n8n"],"forbidden_flows":["n8n -> provider","n8n -> product database","n8n declares provider success"]},
    {"id":"communications","purpose":"CRM, email, SMS, and social adapter targets with signed event return paths.","systems":["odoo","klyrow-email","telnexa-sms","social"],"allowed_flows":["middleware -> odoo/klyrow/telnexa/social adapter contract","provider/business events -> middleware signed inbox"],"forbidden_flows":["browser -> provider runtime","n8n -> provider runtime","provider -> odoo direct cross-system write"]},
    {"id":"crawler","purpose":"Canonical crawler command and result-event boundary.","systems":["kyqra-crawler"],"allowed_flows":["middleware -> crawler job command","crawler result/progress -> middleware"],"forbidden_flows":["crawler -> odoo direct","crawler -> private network target","legacy crawler activation"]},
    {"id":"telephony-restricted","purpose":"Private VICIdial/Asterisk command, readback, and event boundary with campaign isolation.","systems":["vicidial-asterisk"],"allowed_flows":["middleware -> restricted telephony adapter","call events -> middleware"],"forbidden_flows":["public telephony admin API","cross-campaign access","n8n direct dialing"]},
    {"id":"financial-isolated","purpose":"Beyvra non-financial operations integration while financial/trading effects remain isolated.","systems":["beyvra-backend","beyvra-frontend"],"allowed_flows":["beyvra backend -> middleware nonfinancial/CRM boundary","middleware -> beyvra.operations adapter"],"forbidden_flows":["n8n financial mutation","middleware trade/order/wallet/ledger/payment mutation","frontend direct provider write"]},
    {"id":"product-clients","purpose":"Independent product and website callers using versioned Middleware intake and command contracts.","systems":["frontend-restaurant","codestra-frontend","codestra-backend","codestra-cms-backend","breero","booked4seasons","moneybee-frontend","moneybee-backend","freight-frontend","freight-backend","larim-a-frontend","larim-a-backend","telnexa-web","klyrow-web"],"allowed_flows":["public website -> same-origin intake -> caddy/kong/middleware","product backend -> middleware with product-scoped client credentials","middleware operation state -> product backend"],"forbidden_flows":["frontend -> odoo/n8n/provider direct","product backend -> another product database","browser-held provider credentials"]},
    {"id":"observability","purpose":"Read-only telemetry collection, storage, alerting, and operational evidence.","systems":["prometheus","alertmanager","loki","telemetry","tempo","node-exporter","cadvisor","redis-exporter","blackbox-exporter","alloy","postgres-exporter"],"allowed_flows":["middleware/services -> telemetry pipeline","prometheus -> approved scrape targets","alloy/telemetry -> loki/tempo/metrics path","alertmanager -> governed middleware notification handoff"],"forbidden_flows":["telemetry -> business mutation","public native service UI","secret/customer/business payload labels"]},
    {"id":"analytics","purpose":"Authenticated read-only operational and business analytics.","systems":["grafana","superset"],"allowed_flows":["grafana -> prometheus/loki/tempo","superset -> curated read models"],"forbidden_flows":["analytics -> operational mutation","superset -> provider administration database","grafana -> secret material"]},
    {"id":"secrets","purpose":"OpenBao secret, policy, auth, audit, storage, and recovery authority.","systems":["openbao"],"allowed_flows":["authorized runtime -> openbao private API","keycloak -> openbao oidc"],"forbidden_flows":["default broad role","committed root/unseal material","initialization without custody/backup/DR approval"]},
    {"id":"governance","purpose":"Contracts, documentation, architecture, infrastructure coordination, and reference evidence.","systems":["sdk","documentation","infrastructure","communications-architecture","codestra-production-platform"],"allowed_flows":["source references","contract generation","release evidence coordination"],"forbidden_flows":["runtime duplication","secret values","automatic deployment authorization"]},
    {"id":"planned-control-planes","purpose":"Planned operator and governance applications that must consume Middleware/SDK contracts.","systems":["marketing-control-plane","communications-control-center","social-control-plane","ai-control-plane"],"allowed_flows":["planned client -> caddy/kong/middleware","read models -> planned client"],"forbidden_flows":["direct provider credentials","provider runtime duplication","activation before contract acceptance"]},
    {"id":"legacy-disabled","purpose":"Historical, placeholder, or superseded repositories retained without runtime authority.","systems":["scrapper-legacy","kyqra-legacy","codestraxxxx"],"allowed_flows":["migration/evidence reference"],"forbidden_flows":["production runtime","new credentials","second command/event ledger"]}
  ]
}
