{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codestra.co/middleware/odoo-lead-command.v1.json",
  "title": "Codestra Odoo CRM lead upsert command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "type",
    "tenant_id",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "schema_version",
    "lead_source",
    "source_record_id",
    "initial_stage",
    "review_required",
    "allow_external_contact",
    "provenance",
    "consent",
    "lead"
  ],
  "properties": {
    "command_id": {"type": "string", "format": "uuid"},
    "type": {"const": "codestra.odoo.crm.lead.upsert.v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 255},
    "schema_version": {"const": 1},
    "lead_source": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "initial_stage": {"enum": ["new", "review_pending"]},
    "review_required": {"type": "boolean"},
    "allow_external_contact": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "captured_by", "source_reference", "legal_basis"],
      "properties": {
        "method": {"enum": ["submitted_by_person", "crawler_discovery", "scraper_import"]},
        "captured_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_reference": {"type": "string", "minLength": 1, "maxLength": 1024},
        "legal_basis": {"enum": ["consent", "legitimate_interest_review_required", "contract_request", "unknown_review_required"]},
        "content_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "channels"],
      "properties": {
        "status": {"enum": ["granted", "denied", "not_applicable", "unknown"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "policy_version": {"type": ["string", "null"], "maxLength": 128},
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["email", "sms", "phone"],
          "properties": {
            "email": {"type": "boolean"},
            "sms": {"type": "boolean"},
            "phone": {"type": "boolean"}
          }
        }
      }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "contact", "company", "tags"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": ["string", "null"], "maxLength": 10000},
        "contact": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": ["string", "null"], "maxLength": 255},
            "email": {"type": ["string", "null"], "format": "email", "maxLength": 320},
            "phone": {"type": ["string", "null"], "maxLength": 64},
            "preferred_language": {"type": ["string", "null"], "maxLength": 16}
          }
        },
        "company": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": ["string", "null"], "maxLength": 255},
            "domain": {"type": ["string", "null"], "maxLength": 255},
            "industry": {"type": ["string", "null"], "maxLength": 255}
          }
        },
        "campaign_code": {"type": ["string", "null"], "maxLength": 128},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true,
          "maxItems": 50
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_required": {"const": true}}},
      "then": {
        "properties": {
          "initial_stage": {"const": "review_pending"},
          "allow_external_contact": {"const": false}
        }
      }
    }
  ]
}
