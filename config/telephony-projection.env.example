# Dedicated VICIdial-to-Odoo call-event projection worker.
# This file contains no credential value and is disabled by default.

APP_ENV=staging
TELEPHONY_ODOO_PROJECTION_ENABLED=false
TELEPHONY_PROJECTION_POLL_SECONDS=0.25

# Use the same immutable Middleware release metadata as the API candidate.
APP_SOURCE_SHA=
IMAGE_DIGEST=
BUILD_TIME=
RELEASE_ID=
CONFIGURATION_CHECKSUM=
SCHEMA_HEAD=0009_observability_incidents
RUNTIME_PROFILE_ID=codestra-telephony-projection-staging-v1

# Durable state. Bind these from the protected staging environment.
DATABASE_URL=
REDIS_URL=
ALLOW_IN_MEMORY_STORAGE=false

# Odoo target and signing secret are deployment-managed. Never commit values.
ODOO_19_BASE_URL=
ODOO_19_HMAC_SECRET=
ODOO_19_TENANT_HMAC_SECRETS={}
ODOO_REQUEST_TIMEOUT_SECONDS=10

# These two gates remain false in the checked-in template. A protected,
# synthetic-only staging certification may turn on only the call-event
# projection after the Odoo readback dependency is deployed and verified.
EXTERNAL_DELIVERY_ENABLED=false
ODOO_WRITE=false

# All telephony/provider effects remain disabled. This worker does not carry
# audio and never calls AMI, ARI, a carrier, or the VICIdial command adapter.
LIVE_WRITE=false
LIVE_WRITES=false
VICIDIAL_WRITES_ENABLED=false
LIVE_PSTN_DIALING=false
PRODUCTION_DIALING=DISABLED
CALLBACK_DISPATCH=false
N8N_DELIVERY_ENABLED=false
SEND_EVENTS=false
LIVE_EMAIL_DELIVERY=false
LIVE_SMS_DELIVERY=false
SOCIAL_PUBLISHING_ENABLED=false
LIVE_ADVERTISING_ENABLED=false
EXTERNAL_MODEL_CALLS_ENABLED=false
