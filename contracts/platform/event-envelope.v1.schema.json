{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codestra.co/event-envelope.v1.schema.json",
  "title": "Codestra Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "source", "tenant_id", "correlation_id", "causation_id", "occurred_at", "schema_version", "payload_hash", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 100},
    "tenant_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "occurred_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": 1},
    "payload_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {"type": "object"}
  }
}
