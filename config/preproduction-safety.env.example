# Fail-closed baseline for discovery, development, CI, and staging.
#
# This file contains no credentials. During runtime discovery, map these controls
# to the exact variable names already supported by the live middleware. Do not
# silently assume an unsupported variable protects an external integration.

APP_ENV=staging

# Global external effects
SEND_EVENTS=false
ENABLE_EXTERNAL_DELIVERY=false
LIVE_WRITE=false
LIVE_WRITES=false

# Integration-specific writes and dispatch
ODOO_WRITE=false
CALLBACK_DISPATCH=false
N8N_DELIVERY_ENABLED=false
VICIDIAL_WRITES_ENABLED=false
EXTERNAL_DIAL_ENABLED=false
PRODUCTION_CALLBACKS_ENABLED=false
N8N_PRODUCTION_WORKFLOWS_ENABLED=false

# Telephony must remain explicitly disabled outside an approved activation.
PRODUCTION_DIALING=DISABLED

# A staging deployment must fail closed when a required safety control is
# missing, malformed, or unknown. Never treat absence as permission.
