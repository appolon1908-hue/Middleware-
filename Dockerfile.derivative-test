FROM codestra/middleware:mtls-client-v2-20260817
USER root
RUN apk add --no-cache openssl=3.5.7-r0
COPY requirements-test.lock /tmp/requirements-test.lock
RUN python -m pip install --no-cache-dir --disable-pip-version-check --require-hashes -r /tmp/requirements-test.lock
COPY --chown=10001:10001 tests /tests
USER 10001:10001
ENV PYTHONPATH=/app
ENTRYPOINT ["pytest"]
