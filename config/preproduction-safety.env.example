# Fail-closed baseline for discovery, development, CI, and staging.
#
# This file contains no credentials. Runtime discovery must map these controls
# to variables actually enforced by the imported application source.

APP_ENV=staging

# Global external effects
SEND_EVENTS=false
ENABLE_EXTERNAL_DELIVERY=false
LIVE_WRITE=false
LIVE_WRITES=false

# Existing integration-specific writes
ODOO_WRITE=false
CALLBACK_DISPATCH=false
N8N_DELIVERY_ENABLED=false
VICIDIAL_WRITES_ENABLED=false
EXTERNAL_DIAL_ENABLED=false
PRODUCTION_CALLBACKS_ENABLED=false
N8N_PRODUCTION_WORKFLOWS_ENABLED=false
PRODUCTION_DIALING=DISABLED

# Lead intake and Odoo delivery
FORM_ODOO_DELIVERY_ENABLED=false
CRAWLER_ODOO_DELIVERY_ENABLED=false
SCRAPPER_ODOO_DELIVERY_ENABLED=false
CRAWLER_EXTERNAL_CONTACT_ENABLED=false
SCRAPPER_EXTERNAL_CONTACT_ENABLED=false

# Provider effects
SMS_DELIVERY_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
SOCIAL_DELIVERY_ENABLED=false
CRAWLER_EXECUTION_ENABLED=false
SCRAPPER_EXECUTION_ENABLED=false

# Automation control-plane persistence
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=8095
AUTOMATION_STATE_PATH=
AUTOMATION_DATABASE_URL=

# Middleware automation adapter delivery flags. All default to disabled.
ENABLE_ODOO_DELIVERY=false
ENABLE_SMS_DELIVERY=false
ENABLE_EMAIL_DELIVERY=false
ENABLE_DIALING=false
ENABLE_CRAWLER_EXECUTION=false
ENABLE_SOCIAL_PUBLISH=false
ENABLE_PROVISIONING_DELIVERY=false
ENABLE_PRODUCT_DELIVERY=false
ENABLE_PRIVACY_DELIVERY=false

# Adapter endpoints are runtime-owned and remain empty until independently verified.
ODOO_ADAPTER_BASE_URL=
TELNEXA_ADAPTER_BASE_URL=
KLYROW_ADAPTER_BASE_URL=
VICIDIAL_ADAPTER_BASE_URL=
KYQRA_ADAPTER_BASE_URL=
POSTLY_ADAPTER_BASE_URL=
PROVISIONING_ADAPTER_BASE_URL=
IDENTITY_ADAPTER_BASE_URL=
MONEYBEE_ADAPTER_BASE_URL=
BEYVRA_ADAPTER_BASE_URL=
LARIM_A_ADAPTER_BASE_URL=
FREIGHT_ADAPTER_BASE_URL=
BREERO_ADAPTER_BASE_URL=
BOOKED4SEASONS_ADAPTER_BASE_URL=
TRADING_ADAPTER_BASE_URL=
PRIVACY_ADAPTER_BASE_URL=

# Optional bearer token files are mounted from the runtime secret provider.
ODOO_ADAPTER_TOKEN_FILE=
TELNEXA_ADAPTER_TOKEN_FILE=
KLYROW_ADAPTER_TOKEN_FILE=
VICIDIAL_ADAPTER_TOKEN_FILE=
KYQRA_ADAPTER_TOKEN_FILE=
POSTLY_ADAPTER_TOKEN_FILE=
PROVISIONING_ADAPTER_TOKEN_FILE=
IDENTITY_ADAPTER_TOKEN_FILE=
MONEYBEE_ADAPTER_TOKEN_FILE=
BEYVRA_ADAPTER_TOKEN_FILE=
LARIM_A_ADAPTER_TOKEN_FILE=
FREIGHT_ADAPTER_TOKEN_FILE=
BREERO_ADAPTER_TOKEN_FILE=
BOOKED4SEASONS_ADAPTER_TOKEN_FILE=
TRADING_ADAPTER_TOKEN_FILE=
PRIVACY_ADAPTER_TOKEN_FILE=

# Missing, malformed, or unknown controls must fail closed.
