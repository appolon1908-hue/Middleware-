{
  "schemaVersion": 1,
  "eventType": "moneybee.account.provisioned.v1",
  "source": {
    "system": "moneybee-backend",
    "repository": "appolon1908-hue/Moneybee-Backend",
    "transport": "middleware-api",
    "requiredAudience": "middleware-api",
    "requiredScope": "identity.request",
    "idempotencyKey": "event_id"
  },
  "authoritativeBoundaries": {
    "humanIdentityAuthority": "keycloak",
    "moneybeeAccountAuthority": "moneybee-backend",
    "crossSystemMutationBoundary": "middleware",
    "crmAuthority": "odoo",
    "automationAuthority": "n8n"
  },
  "prohibitedPayloadFields": [
    "password",
    "password_hash",
    "verification_code",
    "otp",
    "otp_hash",
    "reset_token",
    "reset_url",
    "access_token",
    "refresh_token",
    "smtp_password",
    "keycloak_admin_credential"
  ],
  "routes": [
    {
      "destination": "odoo-integration",
      "command": "crm.contact.upsert.v1",
      "requiredAudience": "odoo-integration",
      "requiredScope": "odoo.leads.write",
      "delivery": "transactional-outbox"
    },
    {
      "destination": "n8n-automation",
      "command": "onboarding.started.v1",
      "requiredAudience": "n8n-automation",
      "requiredScope": "workflow.trigger",
      "delivery": "transactional-outbox"
    }
  ],
  "marketing": {
    "allowedOnlyWhen": "data.marketing_consent == true",
    "securityEmailPath": "prohibited",
    "mauticSynchronousIdentityMail": false
  }
}
