FROM python:3.12.14-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579

ARG SOURCE_SHA
ARG BUILD_TIME

LABEL org.opencontainers.image.source="https://github.com/appolon1908-hue/Middleware-" \
      org.opencontainers.image.revision="$SOURCE_SHA" \
      org.opencontainers.image.created="$BUILD_TIME" \
      org.opencontainers.image.title="Codestra Middleware" \
      org.opencontainers.image.vendor="Codestra"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --system --gid 10001 middleware \
 && useradd --system --uid 10001 --gid middleware --home-dir /nonexistent middleware

COPY requirements-runtime.txt ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-runtime.txt \
 && python -m pip check

COPY app ./app
COPY workers ./workers
COPY config ./config
COPY contracts ./contracts
COPY migrations ./migrations
COPY scripts/migrate_runtime.py ./scripts/migrate_runtime.py

USER 10001:10001

EXPOSE 8080

CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips=127.0.0.1"]
