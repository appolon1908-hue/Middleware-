{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codestra.co/platform/system-integration-registry.v3.schema.json",
  "title": "Codestra complete system integration registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory", "policy", "columns", "systems"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "inventory_date", "repository_count", "authority", "source_branch"],
      "properties": {
        "account": {"const": "appolon1908-hue"},
        "inventory_date": {"type": "string", "format": "date"},
        "repository_count": {"const": 54},
        "authority": {"const": "appolon1908-hue/Middleware-"},
        "source_branch": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": [
        "middleware_is_only_cross_system_write_authority",
        "principal_repository_owns_runtime",
        "sdk_repository_is_contract_authority",
        "n8n_is_orchestration_only",
        "provider_callbacks_terminate_at_middleware",
        "effectful_writes_require_idempotency",
        "unknown_outcome_requires_readback_before_retry",
        "external_effects_disabled_by_default"
      ]
    },
    "columns": {
      "const": [
        "id",
        "repository",
        "category",
        "lifecycle",
        "cell",
        "integration_mode",
        "middleware_relationship",
        "source_state",
        "canonical",
        "adapter_id"
      ]
    },
    "systems": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "prefixItems": [
          {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          {"type": "string", "pattern": "^appolon1908-hue/.+$"},
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "boolean"},
          {"type": ["string", "null"]}
        ]
      }
    }
  }
}
