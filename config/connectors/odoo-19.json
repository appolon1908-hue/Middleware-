{
  "version": 1,
  "id": "odoo-19",
  "workstream": "integration/odoo-19",
  "repository": "appolon1908-hue/Odoo",
  "role": "erp",
  "transport": {
    "protocol": "internal_https",
    "base_url_env": "ODOO_19_BASE_URL",
    "health_path": "/web/health"
  },
  "authentication": {
    "method": "oidc_client_credentials",
    "keycloak_client_id": "middleware-odoo-19",
    "secret_env": "ODOO_19_CLIENT_SECRET"
  },
  "runtime": {
    "enabled_by_default": false,
    "external_effects_enabled": false,
    "status": "runtime_unconfirmed",
    "notes": "Odoo result delivery is the only activation path for observability projections; live deployment and registry approval remain runtime evidence."
  },
  "deployment_evidence": {
    "deployed": false,
    "verified_commit": null,
    "verified_at": null,
    "notes": "Configuration contract only; no live deployment performed."
  },
  "observability_projection": {
    "contract": "contracts/observability/odoo-sync.v1.json",
    "middleware_api_owner": "appolon1908-hue/Middleware-",
    "odoo_record_owner": "appolon1908-hue/Odoo",
    "enabled_by_default": false,
    "queue": "odoo_result_delivery",
    "operations": [
      "observability.kpis.create",
      "observability.incidents.upsert",
      "observability.kpis.read",
      "observability.incidents.read",
      "observability.sync.read"
    ],
    "controls": [
      "OIDC client credentials",
      "private endpoint registry route",
      "tenant allowlist",
      "Idempotency-Key",
      "X-Codestra-Correlation-ID",
      "bounded payload",
      "bounded retries",
      "Odoo ORM only"
    ]
  }
}
