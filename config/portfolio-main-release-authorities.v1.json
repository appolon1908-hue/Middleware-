        "verify",
        "container"
      ]
    },
    {
      "repository": "appolon1908-hue/backend2",
      "repository_id": 1319903950,
      "default_branch": "main",
      "required_status_checks": [
        "validate",
        "container"
      ]
    },
    {
      "repository": "appolon1908-hue/Telnexa-web",
      "repository_id": 1346958528,
      "default_branch": "main",
      "required_status_checks": [
        "validate-build-smoke",
        "docker-build"
      ]
    },
    {
      "repository": "appolon1908-hue/scrapper",
      "repository_id": 1329513537,
      "default_branch": "main",
      "required_status_checks": [
        "deployment-policy",
        "validate"
      ]
    }
  ]
}
