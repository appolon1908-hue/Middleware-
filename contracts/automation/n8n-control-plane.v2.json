{
  "schema_version": "2.0",
  "status": "SOURCE_ONLY",
  "authority": {
    "job_ledger": "codestra-middleware-postgresql",
    "orchestration": "n8n",
    "cross_system_writes": "codestra-middleware",
    "identity": "keycloak",
    "provider_credentials": "middleware-adapters"
  },
  "n8n_client": {
    "issuer": "https://auth.codestra.co/realms/codestra",
    "audience": "middleware-api",
    "grant_type": "client_credentials",
    "maximum_access_token_lifetime_seconds": 300,
    "direct_provider_access": false,
    "direct_database_access": false
  },
  "endpoints": [
    "POST /v2/automation/jobs/claim",
    "GET /v2/automation/jobs/{job_id}",
    "POST /v2/automation/jobs/{job_id}/heartbeat",
    "POST /v2/automation/jobs/{job_id}/steps",
    "POST /v2/automation/jobs/{job_id}/complete",
    "POST /v2/automation/jobs/{job_id}/fail",
    "POST /v2/automation/commands",
    "GET /v2/automation/commands/{command_id}",
    "POST /v2/automation/approvals",
    "GET /v2/automation/approvals/{approval_id}",
    "POST /v2/automation/dead-letters/{dead_letter_id}/replay",
    "POST /v2/automation/jobs/reconcile",
    "GET /v2/automation/capabilities/{capability}"
  ],
  "durable_models": [
    "automation_jobs",
    "automation_job_attempts",
    "automation_job_steps",
    "automation_job_leases",
    "automation_approvals",
    "automation_commands",
    "automation_command_attempts",
    "automation_dead_letters",
    "automation_reconciliation_runs",
    "automation_dispatch_outbox"
  ],
  "required_metadata": [
    "event_id",
    "tenant_id",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "workflow_key",
    "workflow_version",
    "occurred_at",
    "actor.kind",
    "actor.subject"
  ],
  "command_states": [
    "ACCEPTED",
    "BLOCKED",
    "SUBMITTED",
    "UNKNOWN",
    "COMPLETED",
    "FAILED",
    "CANCELLED"
  ],
  "job_states": [
    "PENDING",
    "DISPATCHING",
    "CLAIMED",
    "RUNNING",
    "WAITING_APPROVAL",
    "WAITING_TIMER",
    "WAITING_COMMAND",
    "RETRY_SCHEDULED",
    "COMPLETED",
    "FAILED_TERMINAL",
    "DEAD_LETTER",
    "CANCELLED"
  ],
  "invariants": {
    "durable_inbox_before_acknowledgement": true,
    "job_and_dispatch_outbox_same_transaction": true,
    "lease_required_for_terminal_transition": true,
    "exact_replay_returns_original_result": true,
    "conflicting_replay_rejected": true,
    "unknown_outcome_reconciled_before_retry": true,
    "capability_rechecked_before_effect": true,
    "tenant_isolation_required": true,
    "workflow_activation_enables_capability": false,
    "public_provider_callbacks_to_n8n": false,
    "external_effects_enabled": false
  }
}
